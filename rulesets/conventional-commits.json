{
  "name": "Conventional Commits",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Conventional Commit",
        "negate": false,
        "operator": "regex",
        "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test){1}(\\([\\w\\-\\.\\/]+\\))?(!)?: ([\\w ])+([\\s\\S]*)"
      }
    }
  ],
  "bypass_actors": []
}
